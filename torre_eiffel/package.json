  },
  "dependencies": {
    "@remotion/cli": "4.0.377",
    "@remotion/three": "4.0.377",
    "@react-three/fiber": "8.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.377",
    "three": "0.170.0",
    "@remotion/bundler": "4.0.377",
    "@remotion/renderer": "4.0.377"
  },
  "devDependencies": {
    "@types/react": "18.3.24",
    "@types/three": "0.170.0",
    "typescript": "5.9.3"
  }
}
