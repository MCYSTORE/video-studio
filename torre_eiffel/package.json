{
  "name": "torre-eiffel-short",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs && node scripts/finalize.mjs",
    "qa": "python qa_audit.py out/torre_eiffel_1080p.mp4",
